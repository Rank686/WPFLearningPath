<Window x:Class="WpfLearning.Step02.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Step 02 - StackPanel Layout"
        Width="420"
        Height="260">
    <StackPanel Orientation="Vertical"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
        <TextBlock Text="StackPanel"
                   FontSize="26"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12" />
        <TextBlock Text="Children are arranged from top to bottom."
                   Margin="0,0,0,12" />
        <Button Content="A fixed-width child"
                Width="180"
                HorizontalAlignment="Center" />
    </StackPanel>
</Window>
