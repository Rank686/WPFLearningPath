<Window x:Class="WpfLearning.Step07.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Step 07 - Merged Dictionaries"
        Width="480"
        Height="360">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/TrackTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Orientation="Vertical"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
        <TextBlock Text="Resources now live in another file"
                   Style="{StaticResource SectionTextStyle}" />
        <TextBlock Text="The resource keys did not change"
                   Style="{StaticResource SectionTextStyle}" />
        <Button Content="Subscribed in XAML"
                Width="200"
                Margin="0,4,0,10"
                Click="ChangeText_Click" />
        <Button x:Name="CodeButton"
                Content="Subscribed in C#"
                Width="200" />
    </StackPanel>
</Window>
