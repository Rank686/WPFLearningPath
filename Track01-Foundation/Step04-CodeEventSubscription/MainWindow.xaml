<Window x:Class="WpfLearning.Step04.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Step 04 - C# Event Subscription"
        Width="460"
        Height="300">
    <StackPanel Orientation="Vertical"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
        <TextBlock Text="Two ways to subscribe to Click"
                   FontSize="22"
                   Margin="0,0,0,16" />
        <Button Content="Subscribed in XAML"
                Width="200"
                Margin="0,0,0,10"
                Click="ChangeText_Click" />
        <Button x:Name="CodeButton"
                Content="Subscribed in C#"
                Width="200" />
    </StackPanel>
</Window>
