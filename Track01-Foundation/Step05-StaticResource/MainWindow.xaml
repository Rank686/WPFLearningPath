<Window x:Class="WpfLearning.Step05.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Step 05 - StaticResource"
        Width="460"
        Height="320">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="DarkSlateBlue" />
    </Window.Resources>

    <StackPanel Orientation="Vertical"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
        <TextBlock Text="One brush resource, two consumers"
                   FontSize="22"
                   Foreground="{StaticResource AccentBrush}"
                   Margin="0,0,0,16" />
        <Button Content="Subscribed in XAML"
                Width="200"
                Margin="0,0,0,10"
                Foreground="{StaticResource AccentBrush}"
                Click="ChangeText_Click" />
        <Button x:Name="CodeButton"
                Content="Subscribed in C#"
                Width="200" />
    </StackPanel>
</Window>
