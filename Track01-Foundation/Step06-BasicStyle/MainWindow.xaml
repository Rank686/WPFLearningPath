<Window x:Class="WpfLearning.Step06.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Step 06 - Basic Style"
        Width="480"
        Height="360">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="DarkSlateBlue" />
        <Style x:Key="SectionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <StackPanel Orientation="Vertical"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
        <TextBlock Text="First styled TextBlock"
                   Style="{StaticResource SectionTextStyle}" />
        <TextBlock Text="Second styled TextBlock"
                   Style="{StaticResource SectionTextStyle}" />
        <Button Content="Subscribed in XAML"
                Width="200"
                Margin="0,4,0,10"
                Click="ChangeText_Click" />
        <Button x:Name="CodeButton"
                Content="Subscribed in C#"
                Width="200" />
    </StackPanel>
</Window>
