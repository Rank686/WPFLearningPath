<Window x:Class="WpfLearning.Step34.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfLearning.Step34"
        Title="Step 34 - Register DependencyProperty"
        Width="540"
        Height="360">
    <StackPanel Margin="24">
        <TextBlock FontSize="22"
                   FontWeight="SemiBold"
                   Text="A custom DP is a Binding source without INPC" />
        <local:RatingBadge x:Name="RatingBadge"
                           Rating="3"
                           Margin="0,20,0,18"
                           Padding="18"
                           HorizontalAlignment="Left"
                           Background="LightSkyBlue"
                           BorderBrush="SteelBlue"
                           BorderThickness="2">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Rating: " />
                <TextBlock FontWeight="Bold"
                           Text="{Binding ElementName=RatingBadge, Path=Rating}" />
            </StackPanel>
        </local:RatingBadge>
        <Button Padding="14,6"
                HorizontalAlignment="Left"
                Content="Increase rating"
                Click="IncreaseRating_Click" />
    </StackPanel>
</Window>
