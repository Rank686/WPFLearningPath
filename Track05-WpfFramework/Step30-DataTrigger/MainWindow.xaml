<Window x:Class="WpfLearning.Step30.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Step 30 - DataTrigger" Width="540" Height="350">
    <Window.Resources>
        <Style x:Key="HighlightStyle" TargetType="Border">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="WhiteSmoke" />
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="BorderThickness" Value="2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=HighlightCheckBox, Path=IsChecked}" Value="True">
                    <Setter Property="Background" Value="LightGoldenrodYellow" />
                    <Setter Property="BorderBrush" Value="DarkGoldenrod" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <StackPanel Margin="24">
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Bound data can switch Style setters" />
        <CheckBox x:Name="HighlightCheckBox" Margin="0,16,0,16" Content="Highlight preview" />
        <Border Style="{StaticResource HighlightStyle}">
            <TextBlock FontSize="18" Text="Preview area" />
        </Border>
    </StackPanel>
</Window>
