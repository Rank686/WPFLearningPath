<Window x:Class="WpfLearning.Step27.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Step 27 - BasedOn Style" Width="520" Height="320">
    <Window.Resources>
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="SteelBlue" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="QuietButtonStyle" TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="Gainsboro" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Two styles inherit one named base" />
        <TextBlock Margin="0,8,0,22" Text="Both buttons share padding, margin, and font size from BaseButtonStyle." />
        <StackPanel Orientation="Horizontal">
            <Button Content="Primary" Style="{StaticResource PrimaryButtonStyle}" />
            <Button Content="Quiet" Style="{StaticResource QuietButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
