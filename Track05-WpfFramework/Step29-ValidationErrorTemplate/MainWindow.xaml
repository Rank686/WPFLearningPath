<Window x:Class="WpfLearning.Step29.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WpfLearning.Step29" Title="Step 29 - Validation ErrorTemplate" Width="590" Height="340">
    <Window.Resources>
        <ControlTemplate x:Key="ValidationErrorTemplate">
            <StackPanel Orientation="Horizontal">
                <AdornedElementPlaceholder x:Name="AdornedInput" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Crimson"
                           Text="{Binding ElementName=AdornedInput, Path=AdornedElement.(Validation.Errors)[0].ErrorContent}" />
            </StackPanel>
        </ControlTemplate>
    </Window.Resources>
    <StackPanel Margin="24">
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Put the validation message beside the adorned input" />
        <TextBlock Margin="0,8,0,18" Text="Try letters, 10, and 30." />
        <TextBlock Margin="0,0,0,4" Text="Age" />
        <TextBox Width="420" HorizontalAlignment="Left" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}">
            <TextBox.Text>
                <Binding Path="Age" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules><local:AgeRangeRule ValidationStep="RawProposedValue" /></Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>
    </StackPanel>
</Window>
