<Window x:Class="WpfLearning.Step35.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfLearning.Step35"
        Title="Step 35 - DP Callbacks"
        Width="720"
        Height="560">
    <StackPanel Margin="24">
        <TextBlock FontSize="22"
                   FontWeight="SemiBold"
                   Text="Coerce runs before changed" />
        <TextBlock Margin="0,8,0,16"
                   TextWrapping="Wrap"
                   Text="Try Set 4, then Request 9 twice, then Lower Maximum. A repeated effective value has no changed line." />
        <local:RatingBadge x:Name="RatingBadge"
                           Rating="3"
                           Padding="16"
                           HorizontalAlignment="Left"
                           BorderBrush="SteelBlue"
                           BorderThickness="2">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Effective Rating: " />
                <TextBlock FontWeight="Bold"
                           Text="{Binding ElementName=RatingBadge, Path=Rating}" />
            </StackPanel>
        </local:RatingBadge>
        <StackPanel Orientation="Horizontal"
                    Margin="0,16,0,12">
            <Button Padding="10,6"
                    Margin="0,0,8,0"
                    Content="Set Rating 4"
                    Click="SetFour_Click" />
            <Button Padding="10,6"
                    Margin="0,0,8,0"
                    Content="Request Rating 9"
                    Click="RequestNine_Click" />
            <Button Padding="10,6"
                    Content="Prepare 5, lower Maximum to 3"
                    Click="LowerMaximum_Click" />
        </StackPanel>
        <TextBlock x:Name="StateText"
                   FontWeight="SemiBold" />
        <TextBox x:Name="CallbackLog"
                 Margin="0,12,0,0"
                 Height="230"
                 IsReadOnly="True"
                 TextWrapping="Wrap" />
    </StackPanel>
</Window>
