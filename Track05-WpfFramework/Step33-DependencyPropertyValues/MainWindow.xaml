<Window x:Class="WpfLearning.Step33.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Step 33 - Dependency Property Values" Width="620" Height="400">
    <Window.Resources>
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="15,7" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="ValueButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="LightSkyBlue" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="24">
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Local value overrides Style value" />
        <Button x:Name="ValueButton" Margin="0,18,0,18" Width="210" HorizontalAlignment="Left" Content="Observe my Background" Style="{StaticResource ValueButtonStyle}" />
        <StackPanel Orientation="Horizontal">
            <Button Padding="12,6" Margin="0,0,8,0" Content="Set local orange" Click="SetLocal_Click" />
            <Button Padding="12,6" Content="Clear local value" Click="ClearLocal_Click" />
        </StackPanel>
        <TextBlock x:Name="ValueStatus" Margin="0,20,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
    </StackPanel>
</Window>
