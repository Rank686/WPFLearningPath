<Window x:Class="WpfLearning.Step31.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Step 31 - Routed Events" Width="700" Height="520">
    <StackPanel Margin="24">
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="MouseDown bubbles from inner to outer" />
        <CheckBox x:Name="StopAtInnerCheckBox" Margin="0,12,0,14" Content="Stop at inner handler" />
        <Border x:Name="OuterArea" Padding="24" Background="AliceBlue" BorderBrush="SteelBlue" BorderThickness="2" MouseDown="Outer_MouseDown">
            <Border x:Name="InnerArea" Padding="28" Background="LightGoldenrodYellow" BorderBrush="DarkGoldenrod" BorderThickness="2" MouseDown="Inner_MouseDown">
                <TextBlock x:Name="LeafText" HorizontalAlignment="Center" FontSize="18" Text="Click this TextBlock" />
            </Border>
        </Border>
        <TextBox x:Name="RouteLog" Margin="0,18,0,0" Height="190" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
    </StackPanel>
</Window>
