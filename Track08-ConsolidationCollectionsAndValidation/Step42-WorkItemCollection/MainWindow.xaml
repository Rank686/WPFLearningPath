<Window x:Class="WpfLearning.Step42.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工作项集合" Height="460" Width="700">
    <StackPanel Margin="24">
        <TextBlock Text="工作项集合" FontSize="26" Margin="0,0,0,16"/>
        <WrapPanel Margin="0,0,0,12">
            <Button x:Name="AddButton" Content="Add" Click="Add_Click" Padding="14,6" Margin="0,0,8,0"/>
            <Button x:Name="UpdateButton" Content="Update" Click="Update_Click" Padding="14,6" Margin="0,0,8,0"/>
            <Button x:Name="DeleteButton" Content="Delete" Padding="14,6"/>
        </WrapPanel>
        <ListBox x:Name="WorkItemList" ItemsSource="{Binding}" MinHeight="280">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="6">
                        <TextBlock Text="{Binding Title}" Width="260"/>
                        <TextBlock Text="{Binding IsDone, StringFormat=Done: {0}}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</Window>
