<Window x:Class="WpfLearning.Step43.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工作项视图浏览器" Height="620" Width="800">
    <StackPanel Margin="24">
        <TextBlock Text="工作项视图浏览器" FontSize="26" Margin="0,0,0,16"/>
        <WrapPanel Margin="0,0,0,12">
            <Button x:Name="AddButton" Content="Add" Click="Add_Click" Padding="12,6" Margin="0,0,8,0"/>
            <Button x:Name="UpdateButton" Content="Update" Click="Update_Click" Padding="12,6" Margin="0,0,8,0"/>
            <Button x:Name="DeleteButton" Content="Delete" Padding="12,6" Margin="0,0,8,0"/>
            <Button x:Name="SortButton" Content="Sort" Click="Sort_Click" Padding="12,6" Margin="0,0,8,0"/>
            <Button x:Name="GroupButton" Content="Group" Click="Group_Click" Padding="12,6" Margin="0,0,8,0"/>
            <CheckBox x:Name="OpenOnlyCheckBox" Content="Open only" Click="Filter_Click" VerticalAlignment="Center"/>
        </WrapPanel>
        <ListBox x:Name="WorkItemList"
                 ItemsSource="{Binding ItemsView}"
                 IsSynchronizedWithCurrentItem="True"
                 MinHeight="270">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="4,10,4,4"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="6">
                        <TextBlock Text="{Binding Title}" Width="250"/>
                        <TextBlock Text="{Binding Category}" Width="150"/>
                        <TextBlock Text="{Binding IsDone, StringFormat=Done: {0}}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="Current item" FontWeight="Bold" Margin="0,16,0,6"/>
        <ContentControl x:Name="CurrentItemDetail" Content="{Binding Path=ItemsView/}">
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="20"/>
                        <TextBlock Text="{Binding Category, StringFormat=Category: {0}}"/>
                        <TextBlock Text="{Binding IsDone, StringFormat=Done: {0}}"/>
                    </StackPanel>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </StackPanel>
</Window>
