<Window x:Class="WpfLearning.Step10.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfLearning.Step10"
        Title="Step 10 - DataContext"
        Width="460"
        Height="260">
    <StackPanel Orientation="Vertical"
                Margin="32"
                VerticalAlignment="Center">
        <StackPanel.DataContext>
            <local:Profile DisplayName="Grace Hopper" />
        </StackPanel.DataContext>

        <TextBlock Text="Both descendants inherit one DataContext"
                   FontSize="18"
                   Margin="0,0,0,12" />
        <TextBlock Text="{Binding DisplayName}"
                   FontSize="24"
                   Margin="0,0,0,8" />
        <TextBox Text="{Binding DisplayName}"
                 FontSize="18" />
    </StackPanel>
</Window>
