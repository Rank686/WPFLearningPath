<Window x:Class="WpfLearning.Step09.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfLearning.Step09"
        Title="Step 09 - Object Source Binding"
        Width="460"
        Height="240">
    <Window.Resources>
        <local:Profile x:Key="profile" DisplayName="Ada Lovelace" />
    </Window.Resources>

    <StackPanel Orientation="Vertical"
                Margin="32"
                VerticalAlignment="Center">
        <TextBlock Text="A CLR object is the explicit source"
                   FontSize="20"
                   Margin="0,0,0,12" />
        <TextBlock Text="{Binding Source={StaticResource profile}, Path=DisplayName}"
                   FontSize="24" />
    </StackPanel>
</Window>
