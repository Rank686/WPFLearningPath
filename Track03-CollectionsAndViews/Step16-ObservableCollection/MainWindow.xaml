<Window x:Class="WpfLearning.Step16.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Step 16 - ObservableCollection"
        Width="440"
        Height="330">
    <StackPanel Margin="24">
        <TextBlock FontSize="22"
                   FontWeight="SemiBold"
                   Text="The collection reports row changes" />
        <TextBlock Margin="0,8,0,16"
                   Text="The ItemsSource binding is set once. Buttons mutate that same collection." />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Padding="14,6" Margin="0,0,8,0" Content="Add name" Click="AddName_Click" />
            <Button Padding="14,6" Content="Remove last" Click="RemoveLast_Click" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Names}" />
    </StackPanel>
</Window>
