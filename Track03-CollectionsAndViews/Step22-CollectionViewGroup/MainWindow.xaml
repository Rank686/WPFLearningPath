<Window x:Class="WpfLearning.Step22.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Step 22 - CollectionView Group"
        Width="790"
        Height="620">
    <Window.Resources>
        <DataTemplate x:Key="WorkItemTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Width="190" Text="{Binding Title}" />
                <TextBlock Width="110" Text="{Binding Category}" />
                <CheckBox Content="Active" IsChecked="{Binding IsActive}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="WorkItemDetailTemplate">
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Title}" />
                <TextBlock Margin="0,8,0,0" Text="{Binding Category}" />
                <CheckBox Margin="0,8,0,0" Content="Active" IsChecked="{Binding IsActive}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Group the view by one property" />
        <TextBlock Margin="0,8,0,14" Text="Grouping first clears filter and sort so only one new transformation is visible." />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="AttachFilterButton" Padding="12,6" Margin="0,0,8,0"
                    Content="Attach filter" Click="AttachFilter_Click" />
            <CheckBox x:Name="OnlyActiveCheckBox" Margin="0,0,14,0" VerticalAlignment="Center"
                      Content="Only active" IsEnabled="False" Click="OnlyActiveChanged_Click" />
            <Button Padding="12,6" Margin="0,0,8,0" Content="Sort by title" Click="SortByTitle_Click" />
            <Button Padding="12,6" Content="Clear view shaping" Click="ClearViewShaping_Click" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Button Padding="12,6" Margin="0,0,8,0" Content="Group by category" Click="GroupByCategory_Click" />
            <Button Padding="12,6" Content="Clear grouping" Click="ClearGrouping_Click" />
            <TextBlock x:Name="VisibleCountText" Margin="18,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
        </StackPanel>

        <StackPanel Orientation="Horizontal">
            <ListBox Width="390"
                     Height="350"
                     ItemsSource="{Binding ItemsView}"
                     IsSynchronizedWithCurrentItem="True"
                     ItemTemplate="{StaticResource WorkItemTemplate}">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,10,0,4"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="{Binding Name}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
            </ListBox>

            <Border Width="320"
                    Margin="24,0,0,0"
                    Padding="16"
                    BorderBrush="LightGray"
                    BorderThickness="1">
                <ContentControl Content="{Binding ItemsView/}"
                                ContentTemplate="{StaticResource WorkItemDetailTemplate}" />
            </Border>
        </StackPanel>
    </StackPanel>
</Window>
