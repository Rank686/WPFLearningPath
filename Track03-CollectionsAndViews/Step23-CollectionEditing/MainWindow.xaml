<Window x:Class="WpfLearning.Step23.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Step 23 - Collection Editing"
        Width="940"
        Height="660">
    <Window.Resources>
        <DataTemplate x:Key="WorkItemTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Width="190" Text="{Binding Title}" />
                <TextBlock Width="110" Text="{Binding Category}" />
                <CheckBox Content="Active" IsChecked="{Binding IsActive}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="WorkItemDetailTemplate">
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Title}" />
                <TextBlock Margin="0,8,0,0" Text="{Binding Category}" />
                <CheckBox Margin="0,8,0,0" Content="Active" IsChecked="{Binding IsActive}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <StackPanel Margin="24">
        <StackPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Add one provisional item, then commit or cancel" />
            <TextBlock Margin="0,8,0,14" Text="Begin clears view shaping so the new row cannot be hidden or rearranged." />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="AttachFilterButton" Padding="10,5" Margin="0,0,8,0"
                    Content="Attach filter" Click="AttachFilter_Click" />
            <CheckBox x:Name="OnlyActiveCheckBox" Margin="0,0,12,0" VerticalAlignment="Center"
                      Content="Only active" IsEnabled="False" Click="OnlyActiveChanged_Click" />
            <Button Padding="10,5" Margin="0,0,8,0" Content="Sort" Click="SortByTitle_Click" />
            <Button Padding="10,5" Margin="0,0,8,0" Content="Group" Click="GroupByCategory_Click" />
            <Button Padding="10,5" Content="Clear shaping" Click="ClearViewShaping_Click" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Button Padding="12,6" Margin="0,0,8,0" Content="Begin new" Click="BeginNew_Click" />
            <Button Padding="12,6" Margin="0,0,8,0" Content="Commit new" Click="CommitNew_Click" />
            <Button Padding="12,6" Content="Cancel new" Click="CancelNew_Click" />
            <TextBlock x:Name="EditorStatusText" Margin="18,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
        </StackPanel>

        <StackPanel Orientation="Horizontal">
            <ListBox Width="430"
                     Height="420"
                     ItemsSource="{Binding ItemsView}"
                     IsSynchronizedWithCurrentItem="True"
                     ItemTemplate="{StaticResource WorkItemTemplate}">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,10,0,4" FontSize="16" FontWeight="SemiBold" Text="{Binding Name}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
            </ListBox>

            <StackPanel Width="400" Margin="24,0,0,0">
                <Border Padding="14" BorderBrush="LightGray" BorderThickness="1">
                    <ContentControl Content="{Binding ItemsView/}"
                                    ContentTemplate="{StaticResource WorkItemDetailTemplate}" />
                </Border>

                <Border Margin="0,14,0,0" Padding="14" BorderBrush="SteelBlue" BorderThickness="1">
                    <StackPanel x:Name="Editor">
                        <TextBlock FontWeight="SemiBold" Text="Pending item editor" />
                        <TextBlock Margin="0,10,0,3" Text="Title" />
                        <TextBox Text="{Binding Title}" />
                        <TextBlock Margin="0,10,0,3" Text="Category" />
                        <TextBox Text="{Binding Category}" />
                        <CheckBox Margin="0,10,0,0" Content="Active" IsChecked="{Binding IsActive}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
