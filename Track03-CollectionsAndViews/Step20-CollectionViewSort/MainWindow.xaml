<Window x:Class="WpfLearning.Step20.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Step 20 - CollectionView Sort"
        Width="720"
        Height="500">
    <Window.Resources>
        <DataTemplate x:Key="WorkItemTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Width="190" Text="{Binding Title}" />
                <TextBlock Text="{Binding Category}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="WorkItemDetailTemplate">
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Title}" />
                <TextBlock Margin="0,8,0,0" Text="{Binding Category}" />
                <CheckBox Margin="0,8,0,0" Content="Active" IsChecked="{Binding IsActive}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Sort the view, not the source collection" />
        <TextBlock Margin="0,8,0,14" Text="Initial source order: Write, Review, Run. Clear sort restores that order." />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Padding="14,6" Margin="0,0,8,0" Content="Sort by title" Click="SortByTitle_Click" />
            <Button Padding="14,6" Content="Clear sort" Click="ClearSort_Click" />
        </StackPanel>

        <StackPanel Orientation="Horizontal">
            <ListBox Width="320"
                     Height="260"
                     ItemsSource="{Binding ItemsView}"
                     IsSynchronizedWithCurrentItem="True"
                     ItemTemplate="{StaticResource WorkItemTemplate}" />

            <Border Width="320"
                    Margin="24,0,0,0"
                    Padding="16"
                    BorderBrush="LightGray"
                    BorderThickness="1">
                <ContentControl Content="{Binding ItemsView/}"
                                ContentTemplate="{StaticResource WorkItemDetailTemplate}" />
            </Border>
        </StackPanel>
    </StackPanel>
</Window>
