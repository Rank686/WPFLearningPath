<Window x:Class="WpfLearning.Step17.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Step 17 - DataTemplate"
        Width="520"
        Height="390">
    <StackPanel Margin="24">
        <TextBlock FontSize="22"
                   FontWeight="SemiBold"
                   Text="A template describes one data item" />
        <TextBlock Margin="0,8,0,16"
                   Text="Each WorkItem gets the same small visual structure." />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Padding="14,6" Margin="0,0,8,0" Content="Add item" Click="AddItem_Click" />
            <Button Padding="14,6" Content="Toggle first" Click="ToggleFirst_Click" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8" Padding="10" BorderBrush="LightGray" BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                            <TextBlock Text="{Binding Category}" />
                            <CheckBox Content="Active" IsChecked="{Binding IsActive}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Window>
