<Window x:Class="WpfLearning.Step19.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Step 19 - Master Detail"
        Width="680"
        Height="430">
    <Window.Resources>
        <DataTemplate x:Key="WorkItemTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Width="190" Text="{Binding Title}" />
                <TextBlock Text="{Binding Category}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="WorkItemDetailTemplate">
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Title}" />
                <TextBlock Margin="0,8,0,0" Text="{Binding Category}" />
                <CheckBox Margin="0,8,0,0" Content="Active" IsChecked="{Binding IsActive}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock FontSize="22"
                   FontWeight="SemiBold"
                   Text="Selection and detail share one current item" />
        <TextBlock Margin="0,8,0,16"
                   Text="ListBox is an ItemsControl-derived selector. Select a row to move ItemsView.CurrentItem." />

        <StackPanel Orientation="Horizontal">
            <ListBox Width="300"
                     Height="230"
                     ItemsSource="{Binding ItemsView}"
                     IsSynchronizedWithCurrentItem="True"
                     ItemTemplate="{StaticResource WorkItemTemplate}" />

            <Border Width="300"
                    Margin="24,0,0,0"
                    Padding="16"
                    BorderBrush="LightGray"
                    BorderThickness="1">
                <ContentControl Content="{Binding ItemsView/}"
                                ContentTemplate="{StaticResource WorkItemDetailTemplate}" />
            </Border>
        </StackPanel>
    </StackPanel>
</Window>
