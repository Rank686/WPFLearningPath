<Window x:Class="WpfLearning.Step21.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Step 21 - CollectionView Filter"
        Width="760"
        Height="560">
    <Window.Resources>
        <DataTemplate x:Key="WorkItemTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Width="190" Text="{Binding Title}" />
                <TextBlock Width="110" Text="{Binding Category}" />
                <CheckBox Content="Active" IsChecked="{Binding IsActive}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="WorkItemDetailTemplate">
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Title}" />
                <TextBlock Margin="0,8,0,0" Text="{Binding Category}" />
                <CheckBox Margin="0,8,0,0" Content="Active" IsChecked="{Binding IsActive}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="A predicate decides which view rows are visible" />
        <TextBlock Margin="0,8,0,14" Text="Attach once, then change the captured condition and refresh the same predicate." />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="AttachFilterButton" Padding="12,6" Margin="0,0,8,0"
                    Content="1. Attach predicate" Click="AttachFilter_Click" />
            <CheckBox x:Name="OnlyActiveCheckBox" Margin="0,0,14,0" VerticalAlignment="Center"
                      Content="2. Only active" IsEnabled="False" Click="OnlyActiveChanged_Click" />
            <Button Padding="12,6" Content="Clear filter" Click="ClearFilter_Click" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Button Padding="12,6" Margin="0,0,8,0" Content="Sort by title" Click="SortByTitle_Click" />
            <Button Padding="12,6" Content="Clear sort" Click="ClearSort_Click" />
            <TextBlock x:Name="VisibleCountText" Margin="18,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
        </StackPanel>

        <StackPanel Orientation="Horizontal">
            <ListBox Width="360"
                     Height="280"
                     ItemsSource="{Binding ItemsView}"
                     IsSynchronizedWithCurrentItem="True"
                     ItemTemplate="{StaticResource WorkItemTemplate}" />

            <Border Width="320"
                    Margin="24,0,0,0"
                    Padding="16"
                    BorderBrush="LightGray"
                    BorderThickness="1">
                <ContentControl Content="{Binding ItemsView/}"
                                ContentTemplate="{StaticResource WorkItemDetailTemplate}" />
            </Border>
        </StackPanel>
    </StackPanel>
</Window>
