<Window x:Class="WpfLearning.Step24.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfLearning.Step24"
        Title="Step 24 - ValidationRule"
        Width="470"
        Height="330">
    <StackPanel Margin="24">
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Validate one raw TextBox value" />
        <TextBlock Margin="0,8,0,18" TextWrapping="Wrap"
                   Text="Try letters, -1, and 25. The default red border appears only for invalid input." />

        <TextBlock Margin="0,0,0,4" Text="Price" />
        <TextBox Width="220" HorizontalAlignment="Left">
            <TextBox.Text>
                <Binding Path="Price" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <local:PriceRule ValidationStep="RawProposedValue" />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>

        <Button Margin="0,18,0,10" Padding="14,6" HorizontalAlignment="Left"
                Content="Read source value" Click="ReadSource_Click" />
        <TextBlock x:Name="StatusText" FontWeight="SemiBold" Text="Source Price: 10" />
    </StackPanel>
</Window>
