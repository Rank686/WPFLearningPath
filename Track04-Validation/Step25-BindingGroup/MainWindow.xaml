<Window x:Class="WpfLearning.Step25.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfLearning.Step25"
        Title="Step 25 - BindingGroup"
        Width="530"
        Height="430">
    <StackPanel Margin="24">
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Validate two proposed values together" />
        <TextBlock Margin="0,8,0,18" TextWrapping="Wrap"
                   Text="Try Start 50 and Buy now 40, then Save. The source changes only after the whole group is valid." />

        <StackPanel x:Name="OfferEditor">
            <StackPanel.BindingGroup>
                <BindingGroup>
                    <BindingGroup.ValidationRules>
                        <local:PriceOrderRule ValidationStep="ConvertedProposedValue" />
                    </BindingGroup.ValidationRules>
                </BindingGroup>
            </StackPanel.BindingGroup>

            <TextBlock Margin="0,0,0,4" Text="Start price" />
            <TextBox Width="220" HorizontalAlignment="Left">
                <TextBox.Text>
                    <Binding Path="StartPrice" Mode="TwoWay">
                        <Binding.ValidationRules>
                            <local:PriceRule ValidationStep="RawProposedValue" />
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>

            <TextBlock Margin="0,14,0,4" Text="Buy-now price" />
            <TextBox Width="220" HorizontalAlignment="Left">
                <TextBox.Text>
                    <Binding Path="BuyNowPrice" Mode="TwoWay">
                        <Binding.ValidationRules>
                            <local:PriceRule ValidationStep="RawProposedValue" />
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
        </StackPanel>

        <Button Margin="0,20,0,10" Padding="14,6" HorizontalAlignment="Left"
                Content="Save offer" Click="SaveOffer_Click" />
        <TextBlock x:Name="StatusText" FontWeight="SemiBold" TextWrapping="Wrap"
                   Text="No commit attempted" />
    </StackPanel>
</Window>
