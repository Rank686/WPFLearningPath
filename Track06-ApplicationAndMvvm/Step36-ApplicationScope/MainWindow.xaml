<Window x:Class="WpfLearning.Step36.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Step 36 - Application Scope"
        Height="260"
        Width="460">
    <StackPanel Margin="24">
        <TextBlock FontSize="22"
                   FontWeight="SemiBold"
                   Text="Application owns the windows" />
        <TextBlock Margin="0,12,0,18"
                   TextWrapping="Wrap"
                   Text="The accent brush lives in Application.Resources, so every window can use it." />
        <Button Width="160"
                Padding="10,6"
                HorizontalAlignment="Left"
                Background="{StaticResource AppAccentBrush}"
                Foreground="White"
                Content="Open tool window"
                Click="OpenToolWindow_Click" />
        <TextBlock Margin="0,18,0,0"
                   TextWrapping="Wrap"
                   Text="Keep the tool window open, then close this main window. The application exits because ShutdownMode is OnMainWindowClose." />
    </StackPanel>
</Window>
