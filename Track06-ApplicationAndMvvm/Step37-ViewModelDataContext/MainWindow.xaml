<Window x:Class="WpfLearning.Step37.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Step 37 - ViewModel DataContext"
        Height="340"
        Width="480">
    <StackPanel Margin="24">
        <TextBlock FontSize="22"
                   FontWeight="SemiBold"
                   Text="ViewModel supplies window state" />
        <TextBlock Margin="0,14,0,5"
                   Text="Name" />
        <TextBox Width="260"
                 HorizontalAlignment="Left"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Margin="0,12,0,20"
                   FontSize="18"
                   Text="{Binding Greeting}" />
        <Button Width="160"
                Padding="10,6"
                HorizontalAlignment="Left"
                Background="{StaticResource AppAccentBrush}"
                Foreground="White"
                Content="Open tool window"
                Click="OpenToolWindow_Click" />
        <TextBlock Margin="0,16,0,0"
                   TextWrapping="Wrap"
                   Text="Previous lesson retained: Application still owns startup, shared resources, and shutdown." />
    </StackPanel>
</Window>
