<Window x:Class="WpfLearning.Step38.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Step 38 - RelayCommand MVVM" Height="410" Width="500">
    <StackPanel Margin="24">
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="ViewModel command" />
        <TextBlock Margin="0,14,0,5" Text="Name" />
        <TextBox Width="260" HorizontalAlignment="Left"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Margin="0,12,0,12" FontSize="18" Text="{Binding Greeting}" />
        <Button Width="120" Padding="10,6" HorizontalAlignment="Left"
                Content="Save" Command="{Binding SaveCommand}" />
        <TextBlock Margin="0,10,0,22" Text="{Binding SavedMessage}" />
        <Button Width="160" Padding="10,6" HorizontalAlignment="Left"
                Background="{StaticResource AppAccentBrush}" Foreground="White"
                Content="Open tool window" Click="OpenToolWindow_Click" />
        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap"
                   Text="Application startup, shared resources, and shutdown remain from the previous lessons." />
    </StackPanel>
</Window>
