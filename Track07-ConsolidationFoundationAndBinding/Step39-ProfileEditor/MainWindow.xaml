<Window x:Class="WpfLearning.Step39.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="个人资料编辑" Height="260" Width="360">
    <StackPanel Margin="24">
        <TextBlock Text="姓名" />
        <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Margin="0,12,0,0" Text="城市" />
        <TextBox Text="{Binding City, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Margin="0,18,0,0" Text="{Binding Summary}" />
    </StackPanel>
</Window>
