<Window x:Class="WpfLearning.Step40.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfLearning.Step40"
        Title="分数转换预览" Height="340" Width="360">
    <Window.Resources>
        <local:ProfileViewModel x:Key="Profile" />
        <local:ScoreToGradeConverter x:Key="ScoreToGrade" />
    </Window.Resources>
    <StackPanel Margin="24" DataContext="{Binding Source={StaticResource Profile}}">
        <TextBlock Text="姓名" />
        <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Margin="0,12,0,0" Text="城市" />
        <TextBox Text="{Binding City, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Margin="0,18,0,0" Text="{Binding Summary}" />
        <TextBlock Margin="0,18,0,0" Text="分数" />
        <Slider Minimum="0" Maximum="100" Value="{Binding Score, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="{Binding Score}" />
        <TextBlock Text="{Binding Score, Converter={StaticResource ScoreToGrade}}" />
    </StackPanel>
</Window>
