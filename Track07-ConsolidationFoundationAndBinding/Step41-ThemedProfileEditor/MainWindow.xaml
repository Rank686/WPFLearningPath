<Window x:Class="WpfLearning.Step41.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfLearning.Step41"
        Title="资源化资料编辑器" Height="430" Width="400">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/ProfileTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:ProfileViewModel x:Key="Profile" />
            <local:ScoreToGradeConverter x:Key="ScoreToGrade" />
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="24" Background="{StaticResource PageBrush}" DataContext="{Binding Source={StaticResource Profile}}">
        <Border Padding="16" Background="{StaticResource PanelBrush}">
            <StackPanel>
                <TextBlock Text="姓名" />
                <TextBox Style="{StaticResource FieldTextBoxStyle}" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,12,0,0" Text="城市" />
                <TextBox Style="{StaticResource FieldTextBoxStyle}" Text="{Binding City, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock x:Name="ProfileSummary" Margin="0,18,0,0" Style="{StaticResource StatusTextStyle}" Text="{Binding Summary}" />
                <TextBlock Margin="0,18,0,0" Text="分数" />
                <Slider Minimum="0" Maximum="100" Value="{Binding Score, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding Score}" />
                <TextBlock Text="{Binding Score, Converter={StaticResource ScoreToGrade}}" />
            </StackPanel>
        </Border>
        <Border Height="8" Margin="0,12" Background="{StaticResource AccentBrush}" />
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource ActionButtonStyle}" Content="保存" Click="Save_Click" />
            <Button x:Name="ClearStatusButton" Style="{StaticResource ActionButtonStyle}" Content="清空状态" />
        </StackPanel>
        <TextBlock x:Name="SaveStatus" Style="{StaticResource StatusTextStyle}" />
    </StackPanel>
</Window>
